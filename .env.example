# Copie para .env na raiz: cp .env.example .env
#
# Docker: na pasta do repositório rode `docker compose up -d`
# - API: http://localhost:8000
# - Frontend (nginx): http://localhost:8080
# O Postgres não é exposto na máquina (só rede interna do Compose), para não conflitar com 5432 local.

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Chave da Anthropic (opcional para o portal Cidade do Idoso; use um placeholder se não usar IA)
ANTHROPIC_API_KEY=

# URL usada pela API e pelo Alembic dentro do Docker (não altere se usar docker-compose.yml padrão)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/cidade_idoso
